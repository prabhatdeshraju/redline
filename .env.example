# Redline — the environment variables this build reads.
# Copy to .env.local and fill in. .env.local is gitignored; never commit a key.

# Supabase, for accounts and (later) the library.
# Both are optional. With neither set the application still runs and a document
# can still be inspected — only the library and the reader's red lines need an
# account, and the interface says so rather than failing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The model, called through OpenRouter. Not read by this ticket.
# The model identifier lives here and never in code.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# How much extracted text Redline will carry, in characters. Optional.
# Left empty it is 250,000 — roughly 60k tokens, which leaves room for the
# analysis instructions and the analysis itself inside a typical context window.
# A longer document is refused with its length and this limit both stated; it is
# never truncated. Read in the browser, so the name has to start NEXT_PUBLIC_.
NEXT_PUBLIC_MAX_EXTRACTED_CHARACTERS=
